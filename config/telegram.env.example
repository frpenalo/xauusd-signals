# Copia este archivo a config/telegram.env y rellena los dos valores.
# config/telegram.env está en .gitignore: nunca se sube al repo.
#
# 1. En Telegram abre @BotFather, manda /newbot, ponle nombre y usuario.
#    BotFather responde con el token (algo como 123456789:AAH...).
# 2. Abre un chat con tu bot nuevo y mándale cualquier mensaje ("hola").
# 3. Corre:  python daily_signal.py --telegram-chat-id
#    Imprime el chat_id de quien le escribió al bot. Pégalo abajo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
